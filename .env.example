# LeakLens Environment Variables Configuration

# Application Metadata
APP_NAME=LeakLens
APP_VERSION=1.0.0
ENVIRONMENT=development

# Data Source Mode: "demo" (default offline synthetic mode) or "external"
DATA_SOURCE_MODE=demo

# Database URL
# Default SQLite (zero-configuration): sqlite:///./leaklens.db
# PostgreSQL: postgresql://postgres:postgres@localhost:5432/leaklens
DATABASE_URL=sqlite:///./leaklens.db

# External Threat Feed Provider (Optional - only required if DATA_SOURCE_MODE=external)
EXTERNAL_API_BASE_URL=
EXTERNAL_API_KEY=

# Rate Limiting & Security
RATE_LIMIT_PER_MINUTE=60
